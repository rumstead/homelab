[Unit]
Description=Load the {{ crash_recovery_watchdog_module }} hardware watchdog
DefaultDependencies=no
After=systemd-modules-load.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Loading by name skips the Ubuntu blacklist that systemd-modules-load honors.
ExecStart=/usr/sbin/modprobe {{ crash_recovery_watchdog_module }}

[Install]
WantedBy=sysinit.target
